<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trang chủ</title>
</head>
<body>
    <h1>Đây là trang chủ</h1>
    <% if (number%2==1){%>
    <span style="color: red;">Tên lớp: <%=classname%></span>
    <% } else { %>
         <span style="color: blue;">Tên lớp: <%=classname%></span>
    <%}%>
    <h3>Danh sách số là</h3>
    <ul>
    <% for (item of arr) {%>
        <li><%=item%></li>
    <%}%>
    </ul>
</body>
</html>